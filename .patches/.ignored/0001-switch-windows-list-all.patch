     }
 
-    /// Every window the app reports, unfiltered and in its own order.
+    /// Every window the app reports, including main or focused windows omitted from its list.
     static func windows(in application: AXUIElement) -> [AXUIElement] {
         var value: CFTypeRef?
-        guard
-            AXUIElementCopyAttributeValue(application, kAXWindowsAttribute as CFString, &value)
-                == .success,
-            let windows = value as? [AXUIElement]
-        else { return [] }
+        let result = AXUIElementCopyAttributeValue(
+            application, kAXWindowsAttribute as CFString, &value)
+        var windows = result == .success ? value as? [AXUIElement] ?? [] : []
+        for attribute in [kAXMainWindowAttribute, kAXFocusedWindowAttribute] {
+            guard let window = element(application, attribute),
+                !windows.contains(where: { CFEqual($0, window) })
+            else { continue }
+            windows.append(window)
+        }
         return windows
     }
 
